<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS HttpPlatformHandler configuration for Freight Bill Processor.

  BEFORE PUBLISHING:
  1. Set processPath to the REAL Python binary (not the uv trampoline).
     Find it with:  uv run python -c "import sys; print(sys.executable)"
  2. Update the three CARRIER_* environment variables to match the server's OneDrive paths.
  3. Grant IIS_IUSRS Read & Execute on this folder.
  4. Grant IIS_IUSRS Read & Execute on the Python binary.
  5. Create a dedicated Application Pool (not DefaultAppPool).
  6. Recycle the Application Pool after any changes.
-->
<configuration>
  <system.webServer>

    <security>
      <requestFiltering>
        <!-- Match Flask's 200 MB limit — IIS default is 30 MB and blocks larger uploads with 413 -->
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>

    <handlers>
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified" />
    </handlers>

    <httpPlatform
      processPath="C:\Users\MANNY.DEV1\AppData\Roaming\uv\python\cpython-3.14.3-windows-x86_64-none\python.exe"
      arguments="run_server.py"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\python.log"
      startupTimeLimit="60"
      requestTimeout="00:05:00">

      <environmentVariables>
        <!-- IIS injects the available port here — Waitress reads it in run_server.py -->
        <environmentVariable name="HTTP_PLATFORM_PORT" value="%HTTP_PLATFORM_PORT%" />

        <!-- Absolute path to credentials.json — Path.home() resolves incorrectly under IIS -->
        <environmentVariable name="SWCORP_CREDS_PATH"
          value="C:\Users\MANNY.DEV1\.swcorp\credentials.json" />

        <!-- Machine-specific OneDrive/SharePoint paths — update per environment -->
        <environmentVariable name="CARRIER_BILLS_DIR"
          value="C:\Users\MANNY.DEV1\SWCorp\AP Team - Documents\AP\Carrier Bills Import\Import Files" />
        <environmentVariable name="CARRIER_SOURCE_DIR"
          value="C:\Users\MANNY.DEV1\SWCorp\AP Team - Documents\AP\Carrier Bills Import\Carrier Import File - Iris" />
        <environmentVariable name="CARRIER_AUDIT_DIR"
          value="C:\Users\MANNY.DEV1\SWCorp\AP Team - Documents\AP\Carrier Bills Import\Carrier Import File - Audit" />
      </environmentVariables>
    </httpPlatform>

  </system.webServer>
</configuration>
